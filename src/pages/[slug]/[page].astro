---
// 改ページした記事の2ページ目以降（WordPressと同じ /22396/2/ の形）
// 親子の固定ページ（WordPressの /web-site/site/ の形）もここで受ける
import { getEmDashEntry, decodeSlug } from "emdash";
import { slugCandidates } from "../../diver/site";

const slug = decodeSlug(Astro.params.slug);
const page = Astro.params.page ?? "";
if (!slug || !page) return Astro.rewrite("/404");
if (!/^\d+$/.test(page)) {
	// 子の固定ページ: /親/子/ → 子のスラッグの固定ページを表示
	const child = decodeSlug(page);
	for (const s of child ? slugCandidates(child) : []) {
		const { entry } = await getEmDashEntry("pages", s);
		if (entry) return Astro.rewrite(`/pages/${encodeURIComponent(s)}`);
	}
	return Astro.rewrite("/404");
}
if (Number(page) <= 1) return Astro.redirect(`/${slug}/`, 301);

for (const s of slugCandidates(slug)) {
	const { entry } = await getEmDashEntry("posts", s);
	if (entry) return Astro.rewrite(`/posts/${encodeURIComponent(s)}?page=${Number(page)}`);
}
return Astro.rewrite("/404");
---
