---
// トップページ：site.ts の frontPage があればその固定ページ（delta-a.net は「ごあいさつ」）、なければ新着記事の一覧
import { ptComponents } from "../diver/pt";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Layout from "../diver/Layout.astro";
import HomeList from "../diver/HomeList.astro";
import { SITE } from "../diver/site";

// WordPress形式の検索URL（/?s=…）を新しい検索ページへ
const wpSearch = Astro.url.searchParams.get("s");
if (wpSearch !== null) return Astro.redirect(`/search?q=${encodeURIComponent(wpSearch)}`, 301);
// WordPress形式の記事URL（/?p=123）
const wpP = Astro.url.searchParams.get("p") ?? Astro.url.searchParams.get("page_id");
if (wpP && /^\d+$/.test(wpP)) return Astro.redirect(`/${wpP}/`, 301);

const frontSlug: string = (SITE as any).frontPage ?? "";
const r = frontSlug ? await getEmDashEntry("pages", frontSlug) : null;
const front = r?.entry ?? null;
if (front && Astro.cache?.enabled) Astro.cache.set(r!.cacheHint);
---

{front ? (
	<Layout title={SITE.title} canonical={`${Astro.url.origin}/`} content={{ collection: "pages", id: front.data.id, slug: frontSlug }}>
		<article class="d-card d-page">
			<h1 class="d-article__title" {...front.edit.title}>{front.data.title}</h1>
			<div class="d-content" {...front.edit.content}>
				<PortableText value={front.data.content} components={ptComponents} />
			</div>
		</article>
	</Layout>
) : (
	<Layout title={SITE.title} canonical={`${Astro.url.origin}/`}>
		<HomeList page={1} />
	</Layout>
)}
